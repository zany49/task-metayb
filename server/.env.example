NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string: Atlas -> your cluster -> Connect -> Drivers -> copy the string,
# then replace <password> with your database user's password.
# (Atlas clusters, including the free M0 tier, support the transactions this app uses.)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Database name inside the cluster (created automatically)
MONGODB_DB=relay

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Demo OTP: every user logs in with this code (no SMS is sent)
STATIC_OTP=1234
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# Dispatch
# Minutes a rider has to accept an assignment (dispatchers can change it in the app)
CONFIRMATION_TIMEOUT_MINUTES=120
# How often the server checks for assignments whose confirmation time is up
SWEEP_INTERVAL_SECONDS=15
# Demo controls (move the app clock, run the timeout check now). Default: on, except in production
# ENABLE_SIMULATION=true

# Optional: run the database tests against Atlas instead of the built-in in-memory MongoDB.
# Tests always use the separate "relay_test" database and wipe it, never your MONGODB_DB data.
# TEST_MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
