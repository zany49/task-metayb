{
  "name": "relay-server",
  "version": "0.1.0",
  "private": true,
  "description": "Project RELAY - dispatch desk API (Express + MongoDB)",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "seed": "node src/scripts/seed.js",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.24.0",
    "morgan": "^1.10.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.4.0",
    "supertest": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
